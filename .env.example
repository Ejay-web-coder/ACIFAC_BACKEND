# ACIFAC backend configuration. Copy to .env for local development.
# Never commit real values. Hosting platforms should set these as environment variables.

NODE_ENV=development
PORT=4000
ACIFAC_TIME_ZONE=Asia/Manila

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Supabase dashboard -> Connect -> "Session pooler" (port 5432) or "Direct connection".
# Do not use the transaction pooler (port 6543): live updates need LISTEN/NOTIFY.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
# Optional: path to (or PEM of) the Supabase CA certificate to verify TLS.
DATABASE_SSL_CA=
# Local Postgres without TLS only:
# DATABASE_SSL=disable

# --- Supabase Storage (private buckets for ID documents, OCR scans, legal docs) --
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only secret. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web security -------------------------------------------------------------
# Exact frontend origin(s), comma separated. Never "*".
CORS_ORIGIN=http://localhost:5173
# Used to build links in emails (password reset, account setup).
FRONTEND_URL=http://localhost:5173
# "none" when frontend and API are on different sites (e.g. vercel.app + onrender.com), "lax" if same site.
COOKIE_SAMESITE=
TRUST_PROXY_HOPS=1

# --- Email (Gmail: use an App Password, not the account password) --------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=

# --- OCR (one of these) ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# or an OpenAI-compatible endpoint:
OCR_AI_API_KEY=
OCR_AI_URL=https://api.openai.com/v1/chat/completions
OCR_AI_MODEL=gpt-4o-mini
# Scanned forms that pass every authenticity and record check with at least 85%
# reading confidence are saved to their module automatically. Set to false to
# have an admin confirm every form.
OCR_AUTO_POST=true

# --- First administrator (only used by `npm run create-admin`) --------------------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
