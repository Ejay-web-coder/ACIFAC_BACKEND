{
  "name": "acifac-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/run-migrations.js",
    "create-admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "remove-sample-data": "node scripts/remove-sample-data.js",
    "remove-all-members": "node scripts/remove-all-members.js",
    "remove-machinery-kadiwa": "node scripts/remove-machinery-kadiwa.js",
    "test:unit": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3",
    "jest": "^30.5.2"
  }
}
